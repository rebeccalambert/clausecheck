{
  "name": "clausecheck",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "ask": "node --experimental-strip-types --no-warnings src/cli.ts",
    "eval": "node --experimental-strip-types --no-warnings src/eval.ts",
    "test": "node --experimental-strip-types --no-warnings --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
